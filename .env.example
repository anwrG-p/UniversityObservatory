# University Observatory Environment Variables

# ---------------------------------------------------------------------------
# Flask Settings
# ---------------------------------------------------------------------------
FLASK_PORT=5000
FLASK_DEBUG=true
SECRET_KEY=super-secret-observatory-key

# ---------------------------------------------------------------------------
# Cloud Database (For distributed hosting like Render/Vercel)
# If left blank or commented out, the app uses local SQLite
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Firecrawl Integration (Self-Hosted or Cloud API)
# ---------------------------------------------------------------------------
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_API_KEY=fc-local

# ---------------------------------------------------------------------------
# Data Mode
# Set to 'true' to use real scraping and APIs. 'false' uses mock data pool.
# ---------------------------------------------------------------------------
USE_REAL_DATA=false
